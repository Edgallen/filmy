{
  "linked_edits": true,
  "context_servers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"]
    }
  },
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "formatter": [{ "code_action": "source.fixAll.eslint" }]
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": [{ "code_action": "source.fixAll.eslint" }]
    }
  }
}
